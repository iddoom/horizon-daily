{
  "version": "1.0",
  "ai": {
    "provider": "anthropic",
    "model": "glm-5.2",
    "api_key_env": "ANTHROPIC_AUTH_TOKEN",
    "base_url": "https://open.bigmodel.cn/api/anthropic",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 1.5,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-python",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true,
        "category": "it-devtools"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "category": "developer-tools"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "developer-tools"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 50,
      "min_score": 80
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-thinking"
      },
      {
        "name": "OpenAI Blog",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "Google AI Blog",
        "url": "https://blog.google/technology/ai/rss/",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "Google DeepMind Blog",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "ai-thinking"
      },
      {
        "name": "MIT Technology Review",
        "url": "https://www.technologyreview.com/feed/",
        "enabled": true,
        "category": "tech-thinking"
      },
      {
        "name": "TechCrunch",
        "url": "https://techcrunch.com/feed/",
        "enabled": true,
        "category": "it-business"
      },
      {
        "name": "The Verge",
        "url": "https://www.theverge.com/rss/index.xml",
        "enabled": true,
        "category": "digital-tech"
      },
      {
        "name": "Ars Technica",
        "url": "https://feeds.arstechnica.com/arstechnica/index",
        "enabled": true,
        "category": "it-business"
      },
      {
        "name": "Wired AI",
        "url": "https://www.wired.com/feed/tag/ai/latest/rss",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "GitHub Changelog",
        "url": "https://github.blog/changelog/feed/",
        "enabled": true,
        "category": "developer-tools"
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/newrss",
        "enabled": true,
        "category": "systems-learning"
      },
      {
        "name": "IT之家",
        "url": "https://www.ithome.com/rss/",
        "enabled": false,
        "category": "digital-tech-cn"
      },
      {
        "name": "BBC World",
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
        "enabled": true,
        "category": "world-news"
      },
      {
        "name": "Al Jazeera",
        "url": "https://www.aljazeera.com/xml/rss/all.xml",
        "enabled": false,
        "category": "world-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "LocalLLaMA",
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 20,
          "min_score": 20,
          "category": "social-knowledge"
        },
        {
          "subreddit": "MachineLearning",
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 20,
          "min_score": 30,
          "category": "social-knowledge"
        },
        {
          "subreddit": "selfhosted",
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 15,
          "category": "social-knowledge"
        },
        {
          "subreddit": "learnpython",
          "sort": "top",
          "time_filter": "week",
          "fetch_limit": 15,
          "min_score": 20,
          "category": "social-knowledge"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": true,
      "actor_id": "61RPP7dywgiy0JPD0",
      "users": [
        "karpathy",
        "sama",
        "emollick",
        "ylecun",
        "demishassabis",
        "gdb",
        "natfriedman",
        "paulg",
        "AndrewYNg",
        "simonw"
      ],
      "fetch_limit": 20,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5,
      "category": "social-knowledge"
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "ai",
        "agent",
        "llm",
        "automation",
        "browser",
        "coding"
      ],
      "min_stars": 20,
      "max_items": 20
    }
  },
  "filtering": {
    "ai_score_threshold": 5.0,
    "time_window_hours": 24,
    "max_items": 28,
    "category_groups": {
      "ai": {
        "name": "AI / Agent / Automation",
        "limit": 10,
        "categories": [
          "ai-news",
          "ai-tools",
          "ai-thinking"
        ]
      },
      "it_digital": {
        "name": "IT / Digital Products",
        "limit": 7,
        "categories": [
          "it-devtools",
          "it-business",
          "digital-tech",
          "digital-tech-cn",
          "tech-thinking",
          "systems-learning"
        ]
      },
      "world": {
        "name": "World Affairs / Geopolitics",
        "limit": 5,
        "categories": [
          "world-news",
          "world-china"
        ]
      },
      "github": {
        "name": "High-signal GitHub Projects",
        "limit": 6,
        "categories": [
          "oss",
          "developer-tools"
        ]
      },
      "social_knowledge": {
        "name": "Reddit / X 实用知识",
        "limit": 8,
        "categories": [
          "social-knowledge"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 5
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "text": "Horizon #{date}\\n\\n#{summary}"
    },
    "headers": ""
  }
}
